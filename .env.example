# ==========================================
# CONFIGURACIÓN DE DOCKER COMPOSE
# ==========================================
# Este archivo contiene las variables de entorno para Docker Compose
# Copia este archivo a .env y ajusta los valores según tu entorno

# ==========================================
# POSTGRESQL DATABASE
# ==========================================
POSTGRES_DB=sol_store
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_HOST=database
POSTGRES_PORT=5432

# ==========================================
# BACKEND (Laravel) - Puerto expuesto
# ==========================================
BACKEND_PORT=8000

# ==========================================
# FRONTEND (Vue) - Puerto expuesto
# ==========================================
FRONTEND_PORT=5173

# ==========================================
# NGINX (si se usa)
# ==========================================
NGINX_PORT=80

# ==========================================
# NOTAS DE CONFIGURACIÓN
# ==========================================
# 1. Los valores de POSTGRES_* deben coincidir con los de taskcurso/.env
# 2. BACKEND_PORT y FRONTEND_PORT son los puertos expuestos al host
# 3. Para producción, considera cambiar las contraseñas
